        <dc:title>Phấn Hoa Lầu Xanh</dc:title>
        <dc:creator opf:file-as="Đình, Tào" opf:role="aut">Tào Đình</dc:creator>
        <dc:contributor opf:file-as="calibre" opf:role="bkp">calibre (9.9.0) [https://calibre-ebook.com]</dc:contributor>
        <dc:date>2012-04-26T17:18:58+00:00</dc:date>
        <dc:description>&lt;p&gt;Sở Sở một tiểu thư xinh đẹp, cành vàng lá ngọc được dạy dỗ cẩn thận trong một gia đình gia giáo, cầm kì thi họa đều tinh thông uyên bác, song cuộc đời nàng lại thực sự “lắm nỗi truân chuyên”. Lẽ ra một người hiền lành biết lẽ phải, trái như thế sẽ phải được hưởng một cuộc đời êm ấm, vậy mà tưởng chừng như bao nhiêu cay đắng của đời người lại đổ dồn hết vào cái con người bé nhỏ, yếu đuối ấy.&lt;/p&gt;</dc:description>
        <dc:publisher>Hoang Nghia Hanh</dc:publisher>
        <dc:language>eng</dc:language>
        <dc:subject>Ngôn tình Trung Quốc</dc:subject>
