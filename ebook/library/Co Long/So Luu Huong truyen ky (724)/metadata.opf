        <dc:title>Sở Lưu Hương truyền kỳ</dc:title>
        <dc:creator opf:file-as="Long, Cổ" opf:role="aut">Cổ Long</dc:creator>
        <dc:contributor opf:file-as="calibre" opf:role="bkp">calibre (9.9.0) [https://calibre-ebook.com]</dc:contributor>
        <dc:date>2012-04-15T05:47:13+00:00</dc:date>
        <dc:description>&lt;p&gt;Sở Lưu Hương là người chấn danh thiên hạ, trong giang hồ đầy dẩy những lời đồn về nhân vật này. Mẫu hình nhân vật này là một người đàn ông trong mơ tưởng của các phụ nữ, anh ta là đạo soái, đẹp trai, có tánh phong lưu, thích mạo hiểm, thich hưởng thụ, thích cấp thời hành lạc, không bị danh lợi bó buộc, chỉ làm những gì mình thích và không ai có thể cưỡng bức anh ta... Bao gồm 8 phần trong hệ liệt&lt;/p&gt;</dc:description>
        <dc:publisher>Hoang Nghia Hanh</dc:publisher>
        <dc:language>vie</dc:language>
