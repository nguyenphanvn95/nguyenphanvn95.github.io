        <dc:title>Vương quốc ảo</dc:title>
        <dc:creator opf:file-as="Minh, Quách Kính" opf:role="aut">Quách Kính Minh</dc:creator>
        <dc:contributor opf:file-as="calibre" opf:role="bkp">calibre (9.9.0) [https://calibre-ebook.com]</dc:contributor>
