        <dc:title>Những bài thuốc trị bệnh bằng trái cây</dc:title>
        <dc:creator opf:file-as="Hà Duyệt Phi, Vương Lợi Kiệt" opf:role="aut">Hà Duyệt Phi, Vương Lợi Kiệt</dc:creator>
        <dc:contributor opf:file-as="calibre" opf:role="bkp">calibre (9.9.0) [https://calibre-ebook.com]</dc:contributor>
        <dc:date>2012-04-22T22:59:27+00:00</dc:date>
        <dc:description>&lt;p class="description"&gt;Trong trái cây tươi có nhiều thành phần rất cần thiết cho cơ thể người như các loại vitamin, hợp chất cacbon, protein, lipit, xenluylô, các chất khoáng v.v... Dùng trái cây làm "thuốc" chữa bệnh chẳng những ít gây ảnh hưởng phụ như các loại thuốc tân dược, mà còn có tác dụng làm cân bằng sinh lý cơ thể, lại ăn ngon miệng.&lt;/p&gt;</dc:description>
        <dc:publisher>Hoang Nghia Hanh</dc:publisher>
