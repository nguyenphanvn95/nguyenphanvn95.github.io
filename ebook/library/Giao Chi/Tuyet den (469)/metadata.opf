        <dc:title>Tuyết đen</dc:title>
        <dc:creator opf:file-as="Chi, Giao" opf:role="aut">Giao Chi</dc:creator>
        <dc:contributor opf:file-as="calibre" opf:role="bkp">calibre (9.9.0) [https://calibre-ebook.com]</dc:contributor>
        <dc:date>2012-04-22T22:59:13+00:00</dc:date>
        <dc:description>&lt;font class="Apple-style-span" face="'MS Shell Dlg 2', sans-serif" size="3"&gt;&lt;span class="Apple-style-span" style="font-size: 12px;"&gt;Tuyết Đen tràn ngập các forum, xâm lấn các blog khác, được các "fan cuồng nhiệt" mang đi chia sẻ khắp nơi tạo nên cơn sốt "tuyết", với những lời giới thiệu tận mây xanh. Tuyết Đen nhanh chóng được báo Mực tím đăng tải. Mỗi tuần, hàng trăm tranh vẽ do độc giả khắp nơi gửi đến phác hoạ nhân vật Tuyết Đen với trí tưởng tượng và tài múa cọ cực kì phong phú.&lt;/span&gt;&lt;/font&gt;</dc:description>
        <dc:publisher>Hoang Nghia Hanh</dc:publisher>
