        <dc:title>Bài Giảng Cuối Cùng</dc:title>
        <dc:creator opf:file-as="Pausch, Randy" opf:role="aut">Randy Pausch</dc:creator>
        <dc:creator opf:file-as="Pausch, Randy" opf:role="aut">Jeffrey Zaslow</dc:creator>
        <dc:contributor opf:file-as="calibre" opf:role="bkp">calibre (9.9.0) [https://calibre-ebook.com]</dc:contributor>
        <dc:date>2012-04-22T23:20:48+00:00</dc:date>
        <dc:description>&lt;p&gt;Bài thuyết trình của Randy, “Thật Sự Đạt Được Những Ước Mơ Tuổi Thơ”, là những triết lý nhẹ nhàng nhưng thâm thúy về cuộc sống. Nó cuốn hút như chính con người ông. Thay vì nói về bệnh tật và cái chết, bài thuyết trình nói về sự sống, về việc thực hiện những ước mơ của chính mình, và tạo điều kiện cho những người khác thực hiện ước mơ.&lt;/p&gt;</dc:description>
        <dc:publisher>Hoang Nghia Hanh</dc:publisher>
