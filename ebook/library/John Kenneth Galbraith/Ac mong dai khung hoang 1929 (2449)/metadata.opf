        <dc:title>Ác mộng đại khủng hoảng 1929</dc:title>
        <dc:creator opf:file-as="Galbraith, John Kenneth" opf:role="aut">John Kenneth Galbraith</dc:creator>
        <dc:contributor opf:file-as="calibre" opf:role="bkp">calibre (9.9.0) [https://calibre-ebook.com]</dc:contributor>
